{
  "name": "week5-integration-testing-cd-simulation",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API integration testing with a simulated CI/CD pipeline",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "test:integration": "node --test tests/integration.test.js",
    "check": "node --check src/app.js && node --check src/db.js && node --check src/server.js",
    "build": "node scripts/build.js",
    "deploy:simulate": "node scripts/deploy-simulate.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "supertest": "^7.1.1"
  }
}
